<Window x:Class="EasyPods.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:EasyPods.ViewModel.ViewModels;assembly=EasyPods.ViewModel"
        mc:Ignorable="d"
        Title="EasyPods — AirPods Manager" 
        Height="570" Width="740"
        WindowStartupLocation="CenterScreen"
        Background="#12131A"
        Foreground="#ECEFF4"
        FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style TargetType="Button" x:Key="ModernButtonStyle">
            <Setter Property="Background" Value="#0A84FF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Border" x:Key="CardStyle">
            <Setter Property="Background" Value="#1E202B"/>
            <Setter Property="BorderBrush" Value="#2E3244"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Bar / Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,18">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock Text="🎧 EasyPods" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF"/>
                <Border Background="#1C382A" CornerRadius="6" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Live WinRT Watcher" FontSize="11" FontWeight="SemiBold" Foreground="#30D158"/>
                </Border>
            </StackPanel>

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="Scan Nearby" 
                        Style="{StaticResource ModernButtonStyle}" 
                        Command="{Binding StartMonitoringCommand}"
                        Margin="0,0,8,0"/>
                <Button Content="Pause" 
                        Background="#2D3142"
                        Style="{StaticResource ModernButtonStyle}" 
                        Command="{Binding StopMonitoringCommand}"/>
            </StackPanel>
        </DockPanel>

        <!-- Status / Alert Bar -->
        <Border Grid.Row="1" Background="#1B2234" BorderBrush="#253556" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,16">
            <DockPanel>
                <TextBlock Text="Status: " FontWeight="SemiBold" Foreground="#82AAFF"/>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#B0B8C8"/>
            </DockPanel>
        </Border>

        <!-- Main Device Presentation Area -->
        <Grid Grid.Row="2">
            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Device Header with Signal Badge -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel DockPanel.Dock="Left">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedAirPods.Name, FallbackValue='Searching for AirPods...'}" FontSize="19" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <Border Background="#232B3E" CornerRadius="5" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedAirPods.FormattedAddress, FallbackValue='Scanning BLE...'}" FontSize="11" Foreground="#82AAFF"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding SelectedAirPods.ModelDisplay, FallbackValue='Bring case near or open lid'}" FontSize="13" Foreground="#8F96A9" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Signal Strength Indicator -->
                            <Border Background="#252837" CornerRadius="6" Padding="10,6" Margin="0,0,10,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📶 " FontSize="12"/>
                                    <TextBlock Text="{Binding SelectedAirPods.SignalStrength, FallbackValue='--'}" FontSize="12" FontWeight="SemiBold" Foreground="#30D158"/>
                                </StackPanel>
                            </Border>

                            <Button Content="Connect Audio" 
                                    Style="{StaticResource ModernButtonStyle}"
                                    Command="{Binding ConnectDeviceCommand}"
                                    CommandParameter="{Binding SelectedAirPods}"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Pod Telemetry Widgets -->
                    <UniformGrid Grid.Row="1" Columns="3" Margin="0,8">
                        <!-- Left Pod Card -->
                        <Border Background="#252837" CornerRadius="10" Padding="16" Margin="6">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="Left Pod" FontSize="14" FontWeight="SemiBold" Foreground="#B0B8C8" HorizontalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,4">
                                    <TextBlock Text="{Binding SelectedAirPods.LeftPodBattery, StringFormat='{}{0}%', FallbackValue='--'}" 
                                               FontSize="30" FontWeight="Bold" Foreground="#30D158"/>
                                    <TextBlock Text=" ⚡" FontSize="20" Foreground="#FFD60A" VerticalAlignment="Center"
                                               Visibility="{Binding SelectedAirPods.LeftPodCharging, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"/>
                                </StackPanel>
                                <TextBlock Text="Ear / Case Sensor" FontSize="11" Foreground="#6E768E" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Right Pod Card -->
                        <Border Background="#252837" CornerRadius="10" Padding="16" Margin="6">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="Right Pod" FontSize="14" FontWeight="SemiBold" Foreground="#B0B8C8" HorizontalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,4">
                                    <TextBlock Text="{Binding SelectedAirPods.RightPodBattery, StringFormat='{}{0}%', FallbackValue='--'}" 
                                               FontSize="30" FontWeight="Bold" Foreground="#30D158"/>
                                    <TextBlock Text=" ⚡" FontSize="20" Foreground="#FFD60A" VerticalAlignment="Center"
                                               Visibility="{Binding SelectedAirPods.RightPodCharging, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"/>
                                </StackPanel>
                                <TextBlock Text="Ear / Case Sensor" FontSize="11" Foreground="#6E768E" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Case Card -->
                        <Border Background="#252837" CornerRadius="10" Padding="16" Margin="6">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="Charging Case" FontSize="14" FontWeight="SemiBold" Foreground="#B0B8C8" HorizontalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,4">
                                    <TextBlock Text="{Binding SelectedAirPods.CaseBattery, StringFormat='{}{0}%', FallbackValue='--'}" 
                                               FontSize="30" FontWeight="Bold" Foreground="#0A84FF"/>
                                    <TextBlock Text=" ⚡" FontSize="20" Foreground="#FFD60A" VerticalAlignment="Center"
                                               Visibility="{Binding SelectedAirPods.CaseCharging, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"/>
                                </StackPanel>
                                <TextBlock Text="Lid Detection" FontSize="11" Foreground="#6E768E" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Bottom Quick Info with Last Seen -->
                    <DockPanel Grid.Row="2" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <TextBlock Text="Beacon Telemetry: " FontSize="11" Foreground="#6E768E"/>
                            <TextBlock Text="{Binding SelectedAirPods.LastSeenText, FallbackValue='Listening...'}" FontSize="11" Foreground="#82AAFF"/>
                        </StackPanel>
                        <TextBlock Text="WinRT BLE Passive/Active Sniffer" FontSize="11" Foreground="#6E768E" DockPanel.Dock="Right"/>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer / Credits -->
        <TextBlock Grid.Row="3" Text="EasyPods • Modular Bluetooth Assistant for Windows" FontSize="11" Foreground="#545B73" HorizontalAlignment="Center" Margin="0,14,0,0"/>
    </Grid>
</Window>
