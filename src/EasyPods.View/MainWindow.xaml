<Window x:Class="EasyPods.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:EasyPods.ViewModel.ViewModels;assembly=EasyPods.ViewModel"
        mc:Ignorable="d"
        Title="EasyPods — AirPods Manager" 
        Height="540" Width="720"
        WindowStartupLocation="CenterScreen"
        Background="#12131A"
        Foreground="#ECEFF4"
        FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif">

    <Window.Resources>
        <Style TargetType="Button" x:Key="ModernButtonStyle">
            <Setter Property="Background" Value="#0A84FF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Border" x:Key="CardStyle">
            <Setter Property="Background" Value="#1E202B"/>
            <Setter Property="BorderBrush" Value="#2E3244"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Bar / Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock Text="🎧 EasyPods" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF"/>
                <Border Background="#1C382A" CornerRadius="6" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="AirPods Ready" FontSize="11" FontWeight="SemiBold" Foreground="#30D158"/>
                </Border>
            </StackPanel>

            <Button DockPanel.Dock="Right" 
                    Content="Scan Nearby" 
                    Style="{StaticResource ModernButtonStyle}" 
                    Command="{Binding StartMonitoringCommand}"/>
        </DockPanel>

        <!-- Status / Alert Bar -->
        <Border Grid.Row="1" Background="#1B2234" BorderBrush="#253556" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,16">
            <DockPanel>
                <TextBlock Text="Status: " FontWeight="SemiBold" Foreground="#82AAFF"/>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#B0B8C8"/>
            </DockPanel>
        </Border>

        <!-- Main Device Presentation Area -->
        <Grid Grid.Row="2">
            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Device Header -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="{Binding SelectedAirPods.Name, FallbackValue='No AirPods Detected'}" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock Text="{Binding SelectedAirPods.ModelDisplay, FallbackValue='Open case or pair nearby'}" FontSize="13" Foreground="#8F96A9" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Button DockPanel.Dock="Right" 
                                Content="Connect Audio" 
                                Style="{StaticResource ModernButtonStyle}"
                                VerticalAlignment="Center"
                                Command="{Binding ConnectDeviceCommand}"
                                CommandParameter="{Binding SelectedAirPods}"/>
                    </DockPanel>

                    <!-- Pod Telemetry Widgets -->
                    <UniformGrid Grid.Row="1" Columns="3" Margin="0,8">
                        <!-- Left Pod Card -->
                        <Border Background="#252837" CornerRadius="10" Padding="16" Margin="6">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="Left Pod" FontSize="14" FontWeight="SemiBold" Foreground="#B0B8C8" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding SelectedAirPods.LeftPodBattery, StringFormat='{}{0}%', FallbackValue='--'}" 
                                           FontSize="28" FontWeight="Bold" Foreground="#30D158" HorizontalAlignment="Center" Margin="0,8,0,4"/>
                                <TextBlock Text="In Case" FontSize="12" Foreground="#6E768E" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Right Pod Card -->
                        <Border Background="#252837" CornerRadius="10" Padding="16" Margin="6">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="Right Pod" FontSize="14" FontWeight="SemiBold" Foreground="#B0B8C8" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding SelectedAirPods.RightPodBattery, StringFormat='{}{0}%', FallbackValue='--'}" 
                                           FontSize="28" FontWeight="Bold" Foreground="#30D158" HorizontalAlignment="Center" Margin="0,8,0,4"/>
                                <TextBlock Text="In Case" FontSize="12" Foreground="#6E768E" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Case Card -->
                        <Border Background="#252837" CornerRadius="10" Padding="16" Margin="6">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="Charging Case" FontSize="14" FontWeight="SemiBold" Foreground="#B0B8C8" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding SelectedAirPods.CaseBattery, StringFormat='{}{0}%', FallbackValue='--'}" 
                                           FontSize="28" FontWeight="Bold" Foreground="#0A84FF" HorizontalAlignment="Center" Margin="0,8,0,4"/>
                                <TextBlock Text="Closed" FontSize="12" Foreground="#6E768E" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Bottom Quick Info -->
                    <DockPanel Grid.Row="2" Margin="0,12,0,0">
                        <TextBlock Text="BLE Advertisement Monitoring: Active" FontSize="11" Foreground="#6E768E" DockPanel.Dock="Left"/>
                        <TextBlock Text="Windows 11 Fluent Edition" FontSize="11" Foreground="#6E768E" DockPanel.Dock="Right"/>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer / Credits -->
        <TextBlock Grid.Row="3" Text="EasyPods • Modular Bluetooth Assistant for Windows" FontSize="11" Foreground="#545B73" HorizontalAlignment="Center" Margin="0,14,0,0"/>
    </Grid>
</Window>
